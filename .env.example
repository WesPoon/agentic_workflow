# Copy to .env for local runs. Never commit .env.

# --- LLM -------------------------------------------------------------------
LLM_PROVIDER=anthropic              # bedrock (AWS credentials, no API key) | anthropic (API key)
LLM_MODEL_ID=claude-opus-5-5   # anthropic route: claude-opus-5-5
LLM_EFFORT=high                     # low | medium | high | xhigh | max (Opus 5.5 default is medium)
AWS_REGION=us-east-1                # Bedrock region; uses your `aws configure` / SSO credentials
# LLM_PROVIDER=anthropic uses, in order: ANTHROPIC_API_KEY, then your `ant auth login` profile.
# Leave the key unset to use the login (local dev only; billed to that Console org, not Claude Pro).
# ANTHROPIC_API_KEY=
# xAI Grok instead:  LLM_PROVIDER=xai  LLM_MODEL_ID=grok-4.7  XAI_API_KEY=xai-...
# (LLM_EFFORT is ignored for xai)
# DeepSeek instead:  LLM_PROVIDER=deepseek  LLM_MODEL_ID=deepseek-v4-pro (or deepseek-flash)
#   DEEPSEEK_API_KEY=sk-...   LLM_EFFORT=high (low | high | max; none = thinking off)
#   LLM_MAX_TOKENS=32768  (thinking tokens count toward this; 8192 can cut off a long strategy file)
# LLM_MAX_TOKENS=8192
# LLM_TIMEOUT_S=600

# --- Persistence -------------------------------------------------------------
PERSISTENCE=sqlite                     # memory | sqlite | dynamodb
# CHECKPOINT_TABLE=momentum-checkpoints
# STORE_TABLE=momentum-store

# --- Artifacts -----------------------------------------------------------------
STORAGE=local                          # local | s3
# ARTIFACT_BUCKET=
# WORK_DIR=./runs

# --- Backtests -----------------------------------------------------------------
COMPUTE_BACKEND=local                  # local (subprocess) | github (branch → Actions → EC2)
# GITHUB_REPO=owner/repo
# GITHUB_TOKEN=
# BACKTEST_TIMEOUT_S=1800
POLYGON_API_KEY=                        # your Polygon key; only needed for the polygon loader

# --- Bounds --------------------------------------------------------------------
# MAX_REVISIONS=3
# MAX_PHASE_STEPS=80
# RECURSION_LIMIT=300

# --- scripts/invoke.py ---------------------------------------------------------
# AGENT_RUNTIME_ARN=
